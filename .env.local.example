COMFLY_API_KEY=your_api_key_here
COMFLY_API_URL=https://ai.comfly.org/v1

# Optional fallback provider settings
GPT_BEST_API_KEY=
GPT_BEST_BASE_URL=

# Logging
LOG_LEVEL=basic
LOG_ALL_REQUESTS=1

# Unified semantic planner (enabled by default)
AGENT_UNIFIED_PLANNER_ENABLED=1
AGENT_PLANNER_PROVIDER_ID=
AGENT_PLANNER_MODEL=
AGENT_PLANNER_TIMEOUT_MS=1800000
AGENT_RUN_TIMEOUT_MS=1800000
AGENT_PLANNER_SHADOW_MODE=0

# Optional async image polling
COMFLY_ASYNC_IMAGE_SUBMIT_TIMEOUT_MS=600000
COMFLY_ASYNC_POLL_TIMEOUT_MS=600000
COMFLY_ASYNC_POLL_INTERVAL_MS=2000

# Optional image size allowlist
IMAGE_SIZE_ALLOWLIST=1024x1024,1024x1792,1792x1024,2048x2048
IMAGE_SIZE_ALLOWLIST_GPT_IMAGE_2=1024x1024,1536x1024,1024x1536,2048x2048,2048x1152,3840x2160,2160x3840

# Opt-in paid supplier image smoke test. Keep IMAGE_SMOKE_CONFIRM unset in normal development and CI.
IMAGE_SMOKE_CONFIRM=
IMAGE_SMOKE_PROVIDER_ID=
IMAGE_SMOKE_MODEL=
IMAGE_SMOKE_BASE_URL=http://127.0.0.1:3001
IMAGE_SMOKE_REFERENCE=0
IMAGE_SMOKE_SIZE=1024x1024
IMAGE_SMOKE_ASPECT_RATIO=1:1
