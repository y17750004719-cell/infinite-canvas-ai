{
  "name": "infinite-canvas-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "brace-expansion@1.1.12": "1.1.13",
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.3": "4.0.5",
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "node --test",
    "test:image-smoke": "node scripts/smoke-image-generation.mjs",
    "lint": "eslint app",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "0.577.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.20",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3"
  }
}
